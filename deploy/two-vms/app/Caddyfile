# Caddy on the server: the only container with open ports.
#
# SITE_ADDRESS comes from .env (via compose.yaml):
#   :80                                               plain HTTP, on any address
#   coffeeshop-ab12.swedencentral.cloudapp.azure.com  HTTPS: Caddy gets a free certificate
#                                                     from Let's Encrypt, renews it, and
#                                                     redirects http:// to https://

{$SITE_ADDRESS} {
	# The API goes to Spring Boot
	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	# Everything else goes to the frontend: Nginx serves the files and falls
	# back to index.html for routes like /products/42.
	handle {
		reverse_proxy frontend:80
	}
}
