# Copy this file to .env and fill it in:   cp .env.example .env
# Never commit .env.

# Where the images are: ghcr.io/<github-owner>/<repository>, in lower case.
# The release workflow publishes <IMAGE_PREFIX>-api and <IMAGE_PREFIX>-frontend.
IMAGE_PREFIX=ghcr.io/your-github-user/coffeeshop

# The version to run: a release tag without the "v" (tag v1.0.0 -> 1.0.0)
APP_VERSION=1.0.0

# :80 for plain HTTP. The VM's DNS name for HTTPS,
# e.g. coffeeshop-ab12.swedencentral.cloudapp.azure.com
SITE_ADDRESS=:80

# The database VM's private IP address (az vm create --private-ip-address)
DB_HOST=10.0.2.10

# Must be the same as in the database VM's .env
DB_USERNAME=coffeeshop
DB_PASSWORD=replace-with-a-long-random-password
