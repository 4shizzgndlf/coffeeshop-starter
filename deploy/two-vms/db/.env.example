# Copy this file to .env and fill it in:   cp .env.example .env
# Never commit .env.

# Make passwords with: openssl rand -hex 24
# DB_USERNAME and DB_PASSWORD must be the same as in the app VM's .env
DB_USERNAME=coffeeshop
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
