# Copy this file to .env and replace the passwords:
#   cp .env.example .env
# Generate strong passwords with e.g.: openssl rand -base64 24
# Never commit .env.

DB_USERNAME=coffeeshop
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password

# Optional local staff account. Created once when the API starts; never commit .env.
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=replace-with-a-long-random-password
